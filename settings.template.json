{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(/etc/passwd)",
      "Read(/etc/shadow)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Read(./**/.netrc)",
      "Read(./**/.git-credentials)",

      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Edit(~/.bashrc)",
      "Write(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Write(~/.zshrc)",
      "Edit(~/.profile)",
      "Write(~/.profile)",
      "Edit(~/.bash_profile)",
      "Write(~/.bash_profile)",
      "Edit(/etc/**)",
      "Write(/etc/**)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo rm:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(chmod -R 777:*)",
      "Bash(chmod 777:*)",
      "Bash(* > /dev/sd*)",
      "Bash(* > /dev/nvme*)",
      "Bash(* > /dev/disk*)",
      "Bash(* > /dev/mem)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",

      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash *)",
      "Bash(curl * | sh *)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(eval *)",

      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(telnet:*)",

      "Bash(crontab:*)",
      "Bash(at:*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cat .env*)",
      "Bash(cat ./**/.env*)",
      "Bash(printenv:*)",
      "Bash(env)",
      "Bash(echo $*KEY*)",
      "Bash(echo $*TOKEN*)",
      "Bash(echo $*SECRET*)"
    ],
    "ask": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)",
      "Bash(brew install:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git pull:*)",
      "Bash(npm run:*)",
      "Bash(npm install)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\"",
            "async": false,
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-safety.mjs\"",
            "async": false,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
